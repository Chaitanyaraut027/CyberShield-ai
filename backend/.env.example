# SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql://user:pass@localhost:5432/cybershield
DATABASE_URL=sqlite:///./cybershield.db
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the AI assistant (otherwise it uses the built-in knowledge base)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
